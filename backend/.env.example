DATABASE_URL=postgres://...            # Tiger Cloud connection string
MODEL_API_KEY=...                      # Meta Model API key
MUSE_MODEL=muse-spark-1.3              # VERIFY with GET https://api.meta.ai/v1/models
MUSE_CACHE_DIR=.cache/muse
MATCHER_MODE=muse                      # muse | hybrid
TEMPORAL_MODEL=decay                   # decay | learned (learned = stretch, §7.7)

# --- Temporal expertise graph (§7) ---
HALF_LIFE_DAYS=30                      # default evidence half-life
HALF_LIFE_HELPED_DAYS=60               # 'helped' evidence (from feedback) fades slower
EXPERTISE_WINDOW_DAYS=180              # evidence older than this is ignored
STRENGTH_SCALE=2.0                     # level = 1 - exp(-strength / STRENGTH_SCALE)
MIN_EVIDENCE_CONFIDENCE=0.6            # drop extracted evidence below this
RELATED_SKILL_WEIGHT=0.35              # how much related skills count (skill-graph smoothing)
SKILL_EDGE_MIN_COOCCUR=2
NEW_SKILL_DAYS=14                      # first_seen within this -> trend 'new'
EXPERTISE_REFRESH_MIN=10               # background recompute of state + temporal scores (no Muse)

# --- Scoring blend (§9.3) ---
W_SEMANTIC=0.6                         # Muse judgment
W_TEMPORAL=0.4                         # temporal graph (decay or learned)
DIR_BONUS_WEIGHT=0.15
NOVELTY_BONUS=0.10                     # never interacted with requester
LOAD_PENALTY_PER_REQUEST=0.05          # per helper request in last 7 days
LOAD_PENALTY_MAX=0.15
UNHELPFUL_PENALTY=0.10                 # same helper, overlapping skills, 30 days after "Not really"
FEEDBACK_HELPED_WEIGHT=1.5

SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...               # Socket Mode app-level token (connections:write)
ENABLE_SLACK=true
SIMULATE_UNMAPPED=true                 # people without slack_user_id get simulated delivery
SIMULATED_ACCEPT_SEC=8

ENABLE_GMAIL=true
GMAIL_POLL_SEC=5
GMAIL_QUERY=to:you+musketeer@example.com   # only this mail is ever read; required
GMAIL_CREDENTIALS=credentials.json     # Google OAuth desktop client (Gmail + Calendar)
GOOGLE_TOKEN_DIR=tokens                # per-person Google sign-ins: python -m app.google <person_id>
DEMO_TIMEZONE=America/New_York         # meeting times are offered in this zone
MEETING_MINUTES=30
DEMO_EMAIL_FALLBACK_PERSON=p_031     # Jordan; confirm from seed_load output

DEFAULT_VIEWER_ID=p_029                # t_events lead (Jordan's manager); confirm from seed_load output
ENABLE_DEV_ROUTES=true

TOPK_STORE=8                           # matches stored per person
CANDIDATE_POOL=15                      # temporal candidates handed to Muse for rerank
AUTO_NOTIFY_THRESHOLD=0.75             # task match score needed to auto-DM
MISSED_MIN_SCORE=0.70                  # potential edges counted as "missed opportunities"
BRIDGE_MIN_SCORE=0.70                  # team overlap needed to draw a bridge
AMBER_AFTER_MIN=2                      # demo value; open task w/o connection -> amber
FEEDBACK_AFTER_MIN=3                   # demo value; ask "was this helpful?"
